rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One profile per user. Users can create/read their own profile, but can
    // NEVER grant themselves a privileged role: `role` must be "donor" on
    // create and can't change afterwards. "staff" is only a *request*
    // (requestedRole); approve it server-side (Admin SDK / custom claims).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == 'donor'
        && request.resource.data.requestedRole in ['donor', 'staff']
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'phone', 'role', 'requestedRole', 'createdAt']);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.requestedRole == resource.data.requestedRole
        && request.resource.data.email == resource.data.email;

      allow delete: if false;
    }
  }
}
